# Database (either DATABASE_URL or the POSTGRES_* variables)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=airflow_sales
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/airflow_sales

# External intelligence providers (never commit real keys; both are optional —
# discovery returns a clean 502 until configured)
TAVILY_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Estimated token cost accounting (USD per million tokens; defaults follow
# Groq's published pricing for the model above)
GROQ_PRICE_PER_M_INPUT_TOKENS=0.15
GROQ_PRICE_PER_M_OUTPUT_TOKENS=0.66

# Provider timeouts and retry policy
SEARCH_TIMEOUT_SECONDS=15
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=2048
LLM_MAX_TOKENS_ESCALATED=4096
MAX_RETRIES=2
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=8

# Bounded critic-driven revision of outreach drafts
OUTREACH_MAX_REVISIONS=2

CORS_ORIGINS=http://localhost:3000,http://localhost:8000
